# ~/.zshenv — dibaca zsh PALING AWAL, untuk SETIAP invocation.
#
# Tugasnya cuma satu: kunci ZDOTDIR supaya config selalu ada di
# $XDG_CONFIG_HOME/zsh, apa pun yang di-set oleh /etc/zshenv, terminal
# emulator, atau environment warisan dari sesi lama.
#
# Di Linux (Ubuntu/Arch) /etc/zsh/zshenv sudah mengeset ZDOTDIR, jadi file ini
# yang dieksekusi. Di macOS/WSL, ZDOTDIR belum tentu di-set → file ini yang
# jadi entry point. Isinya sengaja sama dengan ~/.config/zsh/.zshenv.

if [[ -z ${ZDOTDIR:-} ]]; then
  export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
  export ZDOTDIR="$XDG_CONFIG_HOME/zsh"
fi
