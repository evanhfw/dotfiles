# ~/.config/zsh/.zshrc — managed by chezmoi
# (dipanggil lewat ZDOTDIR yang di-set di ~/.config/zsh/.zshenv)

# --- Homebrew ---------------------------------------------------------------
if [[ -z ${HOMEBREW_PREFIX:-} ]] || ! command -v brew >/dev/null 2>&1; then
  for _brew in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
    [[ -x $_brew ]] && { eval "$($_brew shellenv)"; break }
  done
  unset _brew
fi

# --- PATH -------------------------------------------------------------------
# Urutan penting: ~/.local/bin duluan (biner yang kita install sendiri:
# nvim tarball, yazi, carapace, lazygit), lalu toolchain pribadi per-mesin.
# Ditulis terbalik karena tiap entri di-prepend → yang terakhir jadi pertama.
# `typeset -U path` bikin zsh otomatis dedupe.
typeset -U path PATH
for _p in \
  "$HOME/.fzf/bin" \
  "$HOME/.local/share/go/bin" \
  "$HOME/bin" \
  "$HOME/.brv-cli/bin" \
  "$HOME/.opencode/bin" \
  "$HOME/.bun/bin" \
  "$HOME/.hermes/node/bin" \
  "$HOME/.local/bin"; do
  [[ -d $_p ]] && path=("$_p" $path)
done
unset _p

# --- editor -----------------------------------------------------------------
# Wajib: yazi (dan git, lazygit) ambil opening-nya dari $EDITOR. Kalau unset,
# yazi jatuh ke `vi` — makanya Enter buka vim, bukan nvim.
export EDITOR=nvim
export VISUAL=nvim

# --- history ----------------------------------------------------------------
HISTFILE="${ZDOTDIR:-$HOME}/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt EXTENDED_HISTORY SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS

# --- completion -------------------------------------------------------------
for _d in "${HOMEBREW_PREFIX:-/nonexistent}/share/zsh-completions" \
          /usr/share/zsh-completions /usr/share/zsh/vendor-completions; do
  [[ -d $_d ]] && fpath=("$_d" $fpath)
done
unset _d
autoload -Uz compinit && compinit -i
# -i = abaikan direktori "insecure" tanpa nanya. Homebrew sering bikin
# /opt/homebrew/share jadi group-writable, dan tanpa -i compinit langsung
# prompt di tengah startup shell lalu abort.
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# --- carapace (completion buat ~1000 CLI) -----------------------------------
# Harus SETELAH compinit, SEBELUM zsh-syntax-highlighting.
if command -v carapace >/dev/null 2>&1; then
  zstyle ':completion:*' format $'\e[2;37mCompleting %d\e[m'
  source <(carapace _carapace zsh)
fi

# --- keybinding -------------------------------------------------------------
# Panah atas/bawah nyari history berdasarkan PREFIX yang sudah kamu ketik,
# bukan cuma baris terakhir. Jauh lebih kepake dari sekadar Ctrl+R.
# Ditaruh SEBELUM zsh-syntax-highlighting supaya widget-nya ikut ke-wrap.
if [[ -o interactive ]]; then
  autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
  zle -N up-line-or-beginning-search
  zle -N down-line-or-beginning-search
  bindkey '^[[A' up-line-or-beginning-search    # Up
  bindkey '^[[B' down-line-or-beginning-search  # Down
  bindkey '^[OA' up-line-or-beginning-search    # Up (mode application)
  bindkey '^[OB' down-line-or-beginning-search  # Down (mode application)
fi

# --- ls/ll → eza ------------------------------------------------------------
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --icons --group-directories-first'
  alias ll='eza -lah --icons --group-directories-first --git'
  alias la='eza -a  --icons --group-directories-first'
  alias lt='eza --tree --level=2 --icons'
fi

# --- cat → bat ---------------------------------------------------------------
# --paging=never: `cat file` nggak nyangkut di pager.
# Kalau output dipipe, bat otomatis matiin warna → aman buat `cat x | grep y`.
command -v bat >/dev/null 2>&1 && alias cat='bat --style=plain --paging=never'

# --- mise (version manager: bun, node, pnpm, rust, uv) ----------------------
# Shims ditaruh di PATH supaya tool-nya kebaca JUGA oleh proses non-interaktif
# (editor, LSP, agen). activate = auto-switch versi saat cd.
[[ -d "$HOME/.local/share/mise/shims" ]] && export PATH="$HOME/.local/share/mise/shims:$PATH"
command -v mise >/dev/null 2>&1 && eval "$(mise activate zsh)"

# --- tools ------------------------------------------------------------------
# --cmd cd: `cd` jadi sadar-frekuensi. Path biasa tetap jalan seperti biasa
# (zoxide fallback ke builtin cd), plus bisa loncat: `cd proj` → ~/work/proj.
# Yang interaktif jadi `cdi`.
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh --cmd cd)"

# AUTO_CD: ketik nama folder langsung pindah, tanpa `cd`.
# Karena `cd` udah dipegang zoxide, ini ikut jadi frecency-aware.
setopt AUTO_CD

# --- fzf --------------------------------------------------------------------
# fd sebagai sumber daftar (cepat, hormati .gitignore), bat sebagai preview.
if command -v fd >/dev/null 2>&1; then
  export FZF_DEFAULT_COMMAND='fd --type f --type d --hidden --follow --exclude .git'
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
fi
export FZF_DEFAULT_OPTS="
  --height=60% --layout=reverse --border rounded --info=inline
  --preview 'bat --style=numbers,changes --color=always --line-range=:200 {} 2>/dev/null || eza --tree --level=2 --icons {}'
  --preview-window 'right:55%:wrap:border-left'
"

command -v direnv >/dev/null 2>&1 && eval "$(direnv hook zsh)"
command -v fzf    >/dev/null 2>&1 && source <(fzf --zsh)
# herdr punya completion sendiri (bukan di carapace) — harus setelah compinit.
command -v herdr  >/dev/null 2>&1 && source <(herdr completion zsh)

# --- yazi (file manager) ----------------------------------------------------
# Pakai fungsi, bukan alias biasa: setelah keluar, shell ikut pindah ke
# direktori terakhir yang kamu lihat di yazi.
if command -v yazi >/dev/null 2>&1; then
  y() {
    local tmp cwd
    tmp="$(mktemp -t yazi-cwd.XXXXXX)" || return 1
    yazi "$@" --cwd-file="$tmp"
    IFS= read -r cwd < "$tmp"
    [ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
    rm -f -- "$tmp"
  }
fi

# --- zsh plugins (urutan penting) -------------------------------------------
source_zsh_plugin() {
  local f
  for f in "$@"; do
    [[ -f $f ]] && { source "$f"; return 0 }
  done
  return 1
}

source_zsh_plugin \
  "${HOMEBREW_PREFIX:-/nonexistent}/share/zsh-autosuggestions/zsh-autosuggestions.zsh" \
  /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
  /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=8'

# HARUS paling akhir di antara plugin zsh
source_zsh_plugin \
  "${HOMEBREW_PREFIX:-/nonexistent}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" \
  /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
  /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# --- prompt (paling akhir) --------------------------------------------------
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"

# --- alias QoL --------------------------------------------------------------
alias ..='cd ..'
alias ...='cd ../..'
alias df='df -h'
alias zshrc='nvim $ZDOTDIR/.zshrc'
alias reload='source $ZDOTDIR/.zshrc'
alias ff='fastfetch'
command -v lazygit >/dev/null 2>&1 && alias lg='lazygit'

# `y` sudah didefinisikan sebagai fungsi di atas (pindah cwd setelah keluar).
