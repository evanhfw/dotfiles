{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "background": "opaque",
    "layout": {
      "left": [
        {
          "id": "omarchy.workspaces"
        }
      ],
      "centerBegin": [
        {
          "id": "omarchy.clock",
          "format": "ddd d MMM h:mm AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.elsewhen",
          "cities": [
            {
              "name": "Jakarta",
              "zone": "Asia/Jakarta"
            },
            {
              "name": "Los Angeles",
              "zone": "America/Los_Angeles"
            },
            {
              "name": "New York",
              "zone": "America/New_York"
            },
            {
              "name": "London",
              "zone": "Europe/London"
            },
            {
              "name": "Dubai",
              "zone": "Asia/Dubai"
            }
          ]
        }
      ],
      "center": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.weather"
        }
      ],
      "centerEnd": [
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "crmne.omastats",
          "modules": "cpu,memory,network,gpu,disks,battery",
          "networkStyle": "both",
          "cpuStyle": "graph"
        }
      ],
      "tray": [
        {
          "id": "evan.football"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "evan.deadzone"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "crmne.hyprmoncfg"
        },
        {
          "id": "omaplug"
        }
      ]
    }
  },
  "dock": {
    "position": "bottom",
    "pinned": [
      "org.gnome.Nautilus",
      "chromium",
      "foot",
      "omacalc",
      "omawrite",
      "X",
      "YouTube"
    ]
  },
  "plugins": [
    {
      "id": "typecraft.omacast"
    },
    {
      "id": "evan.deadzone"
    },
    {
      "id": "io.github.sirjul1337.lock-explorer"
    },
    {
      "id": "io.github.gfhdhytghd.hyprcapture"
    }
  ],
  "disabledPlugins": [
    "omarchy.lock"
  ],
  "cloneSourceRestores": [
    "io.github.sirjul1337.lock-explorer"
  ]
}
