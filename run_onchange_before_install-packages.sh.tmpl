#!/usr/bin/env bash
# install paket dasar + CLI tools.
# run_onchange: jalan lagi otomatis kalau isi script ini berubah.
#
# retry: 1   <- naikkan angka ini untuk MEMAKSA script jalan lagi
#              (mis. kalau tadi gagal karena jaringan)
#
# Sengaja TIDAK pakai `set -e`: gagal pasang satu paket (WiFi blip, mirror
# down) nggak boleh menggagalkan `chezmoi apply`, karena itu bikin file
# config nggak ke-apply sama sekali. Kegagalan cukup di-warn.
set -uo pipefail

warn_retry() {
  echo "!! ada paket gagal dipasang (cek koneksi). Naikkan angka di baris"
  echo "   '# retry:' di file sumber, lalu jalankan: chezmoi apply"
}

echo "==> install paket"

{{- if eq .chezmoi.os "darwin" }}

command -v brew >/dev/null || { echo "Homebrew belum ada → https://brew.sh"; exit 1; }
brew install \
  neovim ripgrep fd fzf lazygit tree-sitter-cli node \
  starship zsh-autosuggestions zsh-syntax-highlighting zsh-completions \
  zoxide eza bat direnv carapace yazi \
  mise herdr || warn_retry

{{- else if eq .chezmoi.os "linux" }}

if command -v apt-get >/dev/null; then
  # neovim SENGAJA tidak di sini: repo Ubuntu sering ketinggalan (0.9.x).
  # Blok fallback tarball di bawah yang memasang versi terbaru ke ~/.local.
  # `apt install neovim` justru menaruh versi tua di /usr/bin dan menang di PATH.
  sudo apt-get update -qq
  sudo apt-get install -y zsh ripgrep fzf build-essential git curl unzip file nodejs npm || warn_retry
  opt_mgr=apt
  # zsh-completions NGGAK ADA di Ubuntu (dicek via Launchpad API) — jangan dipaksa.
  # Completion Debian datang dari zsh-common → /usr/share/zsh/vendor-completions,
  # dan .zshrc sudah mencari folder itu.
  opt_pkgs="zsh-autosuggestions zsh-syntax-highlighting zoxide direnv bat fd-find eza"
elif command -v dnf >/dev/null; then
  sudo dnf install -y zsh ripgrep fzf gcc make git curl unzip file nodejs npm || warn_retry
  opt_mgr=dnf
  opt_pkgs="zsh-autosuggestions zsh-syntax-highlighting zoxide direnv bat fd-find eza"
elif command -v pacman >/dev/null; then
  sudo pacman -S --needed --noconfirm zsh ripgrep fzf base-devel git curl unzip file nodejs npm || warn_retry
  opt_mgr=pacman
  # Arch punya semuanya di [extra] (diverifikasi via API archlinux.org)
  opt_pkgs="zsh-autosuggestions zsh-syntax-highlighting zsh-completions zoxide direnv bat fd eza yazi lazygit mise starship"
else
  opt_mgr=""
  opt_pkgs=""
  echo "!! package manager tak dikenal — install manual: zsh neovim ripgrep fd fzf file gcc git node starship zoxide eza mise"
fi

# --- paket opsional: dipasang SATU-SATU -------------------------------------
# apt/dnf/pacman membatalkan SELURUH instalasi kalau ada satu nama paket yang
# nggak dikenal. Jadi batch = satu nama salah, semua ikut gagal.
# Contoh nyata: `zsh-completions` nggak ada di Ubuntu → eza/fd/bat/zoxide
# sebenarnya kepasang semua nggak. Diam-diam aja.
if [ -n "$opt_mgr" ]; then
  for p in $opt_pkgs; do
    case "$opt_mgr" in
      apt)    sudo apt-get install -y "$p" >/dev/null 2>&1 ;;
      dnf)    sudo dnf install -y "$p" >/dev/null 2>&1 ;;
      pacman) sudo pacman -S --needed --noconfirm "$p" >/dev/null 2>&1 ;;
    esac || echo "   (opsional, nggak tersedia di repo: $p)"
  done
fi

# --- Debian/Ubuntu rename biner: fd → fdfind, bat → batcat -------------------
# Tanpa symlink ini: alias `cat`, LazyVim (butuh `fd`), dan preview fzf
# nggak jalan. Diam-diam gagal, jadi sering nggak ketahuan.
mkdir -p "$HOME/.local/bin"
for pair in "fdfind:fd" "batcat:bat"; do
  src_bin="${pair%%:*}"
  dst_bin="${pair##*:}"
  if ! command -v "$dst_bin" >/dev/null 2>&1 && command -v "$src_bin" >/dev/null 2>&1; then
    ln -sf "$(command -v "$src_bin")" "$HOME/.local/bin/$dst_bin" && echo "==> symlink $src_bin → $dst_bin"
  fi
done

# --- lazygit: nggak ada di apt/dnf — ambil tarball rilis resmi --------------
if ! command -v lazygit >/dev/null 2>&1; then
  lg_ver="$(curl -fsSL https://api.github.com/repos/jesseduffield/lazygit/releases/latest 2>/dev/null |
    sed -n 's/.*"tag_name" *: *"v\([^"]*\)".*/\1/p' | head -1)"
  if [ -n "$lg_ver" ]; then
    lg_arch=x86_64
    case "$(uname -m)" in aarch64|arm64) lg_arch=arm64 ;; esac
    echo "==> lazygit v$lg_ver ($lg_arch)"
    mkdir -p "$HOME/.local/bin"
    curl -fL "https://github.com/jesseduffield/lazygit/releases/download/v${lg_ver}/lazygit_${lg_ver}_Linux_${lg_arch}.tar.gz" |
      tar -xz -C "$HOME/.local/bin" lazygit && echo "==> lazygit terpasang"
  fi
fi

# starship & mise: nggak ada di apt/dnf (Arch punya di [extra])
command -v starship >/dev/null || curl -fsSL https://starship.rs/install.sh | sh -s -- -y || warn_retry
command -v mise     >/dev/null || curl -fsSL https://mise.run | sh || warn_retry
# uv diurus mise (lihat dot_config/mise/config.toml) — jangan pasang dobel

# --- yazi: nggak ada di apt/dnf — rilis resmi (zip) -------------------------
if ! command -v yazi >/dev/null 2>&1; then
  yz_arch=x86_64
  case "$(uname -m)" in aarch64|arm64) yz_arch=aarch64 ;; esac
  yz_tmp="$(mktemp -d)"
  echo "==> yazi ($yz_arch)"
  if curl -fL "https://github.com/sxyazi/yazi/releases/latest/download/yazi-${yz_arch}-unknown-linux-gnu.zip" -o "$yz_tmp/yazi.zip"; then
    mkdir -p "$HOME/.local/bin"
    unzip -oq "$yz_tmp/yazi.zip" -d "$yz_tmp"
    find "$yz_tmp" -type f \( -name yazi -o -name ya \) -exec cp {} "$HOME/.local/bin/" \;
    chmod +x "$HOME/.local/bin/yazi" "$HOME/.local/bin/ya" 2>/dev/null
    echo "==> yazi terpasang"
  else
    echo "!! yazi gagal diunduh"
  fi
  rm -rf "$yz_tmp"
fi

# --- carapace: nggak ada di apt/dnf/pacman — rilis resmi (tar.gz) ----------
if ! command -v carapace >/dev/null 2>&1; then
  cp_arch=amd64
  case "$(uname -m)" in aarch64|arm64) cp_arch=arm64 ;; esac
  cp_ver="$(curl -fsSL https://api.github.com/repos/carapace-sh/carapace-bin/releases/latest 2>/dev/null |
    sed -n 's/.*"tag_name" *: *"v\([^"]*\)".*/\1/p' | head -1)"
  if [ -n "$cp_ver" ]; then
    echo "==> carapace v$cp_ver ($cp_arch)"
    mkdir -p "$HOME/.local/bin"
    curl -fL "https://github.com/carapace-sh/carapace-bin/releases/download/v${cp_ver}/carapace-bin_${cp_ver}_linux_${cp_arch}.tar.gz" |
      tar -xz -C "$HOME/.local/bin" carapace && echo "==> carapace terpasang"
  fi
fi
# herdr belum ada paket Linux — lihat dokumentasi herdr

{{- end }}

# --- login shell → zsh (Linux saja; macOS default-nya sudah zsh) -------------
# Jangan chsh di macOS: `command -v zsh` bisa nunjuk ke zsh bawaan Homebrew,
# bukan /bin/zsh, dan chsh-nya minta password.
if [ "$(uname -s)" = "Linux" ] && command -v zsh >/dev/null 2>&1; then
  zsh_bin="$(command -v zsh)"
  if [ "${SHELL:-}" != "$zsh_bin" ]; then
    grep -qx "$zsh_bin" /etc/shells 2>/dev/null || echo "$zsh_bin" | sudo tee -a /etc/shells >/dev/null
    chsh -s "$zsh_bin" || echo "!! chsh gagal — jalankan manual: chsh -s $zsh_bin"
  fi
fi

# --- paket npm global --------------------------------------------------------
# WAJIB pakai --prefix "$HOME/.local". Default prefix npm mengikuti node yang
# sedang aktif: kalau mise, hasilnya jatuh ke
# ~/.local/share/mise/installs/node/<versi>/lib/node_modules dan binernya
# NGGAK masuk PATH (mise cuma bikin shim node/npm, bukan shim tiap paket).
# $HOME/.local/bin dijamin ada di PATH karena ditulis di .zshrc.
npm_pfx="$HOME/.local"

command -v tree-sitter >/dev/null 2>&1 ||
  npm i -g --prefix "$npm_pfx" tree-sitter-cli ||
  echo "tree-sitter-cli (opsional) gagal"

command -v pi >/dev/null 2>&1 ||
  npm i -g --prefix "$npm_pfx" @earendil-works/pi-coding-agent ||
  echo "!! pi gagal diinstall"

# --- neovim: pasang/upgrade ke ~/.local (jangan lewat apt) ------------------
# Kenapa ~/.local: `.local/bin` ada di depan PATH (lihat .zshrc), jadi menang
# atas /usr/bin/nvim bawaan distro. LazyVim (versi yang di-pin di
# lazy-lock.json) butuh nvim >= 0.11.2; repo Ubuntu sering masih 0.9.x atau
# 0.10.x. Di macOS/Arch ini nggak jalan (brew/pacman sudah baru).
if [ "$(uname -s)" = "Linux" ]; then
  nvim_need_install=0
  if command -v nvim >/dev/null; then
    ver="$(nvim --version | head -1 | sed 's/^NVIM v//')"
    maj="${ver%%.*}"
    min="$(printf '%s' "$ver" | cut -d. -f2)"
    # LazyVim (pinned di lazy-lock.json) butuh >= 0.11.2. Kalau kurang, nvim
    # nyangkut di prompt "Press any key to exit" dan sync plugin headless HANG.
    if [ "${maj:-0}" -eq 0 ] && [ "${min:-0}" -lt 11 ]; then nvim_need_install=1; fi
    if [ "${maj:-0}" -eq 0 ] && [ "${min:-0}" -eq 11 ]; then
      patch="$(printf '%s' "$ver" | cut -d. -f3)"
      [ "${patch:-0}" -lt 2 ] && nvim_need_install=1
    fi
  else
    nvim_need_install=1
  fi
  if [ "$nvim_need_install" -eq 1 ]; then
    nv_arch=x86_64
    case "$(uname -m)" in aarch64|arm64) nv_arch=arm64 ;; esac
    nv_tmp="$(mktemp -d)"
    # v0.12.x masih pakai nama "nvim-linux-<arch>"; rilis lama pakai "nvim-linux64".
    # Coba yang baru dulu, fallback ke nama lama kalau 404.
    nv_url="https://github.com/neovim/neovim/releases/latest/download/nvim-linux-${nv_arch}.tar.gz"
    nv_dir="nvim-linux-${nv_arch}"
    echo "==> neovim: unduh tarball terbaru ($nv_arch) → ~/.local"
    if curl -fL "$nv_url" | tar -xz -C "$nv_tmp" 2>/dev/null; then
      mkdir -p "$HOME/.local/bin"
      cp -R "$nv_tmp/$nv_dir/." "$HOME/.local/"
      echo "==> neovim $("$HOME/.local/bin/nvim" --version | head -1)"
    else
      echo "!! neovim gagal diunduh dari $nv_url"
    fi
    rm -rf "$nv_tmp"
  fi
fi

# --- cek akhir: tool mana yang belum ada ------------------------------------
missing=""
for b in zsh nvim git rg fd fzf lazygit node npm starship zoxide eza bat direnv carapace yazi mise uv herdr pi; do
  command -v "$b" >/dev/null 2>&1 || missing="$missing $b"
done
if [ -n "$missing" ]; then
  echo "!! BELUM ADA:$missing"
  echo "   (sebagian opsional — carapace/herdr belum ada paketnya di sebagian distro)"
else
  echo "==> semua tool tersedia"
fi

echo "==> paket selesai"
